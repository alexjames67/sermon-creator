{
  "manifest_version": 3,
  "name": "Mantle",
  "version": "0.1.0",
  "description": "Mantle — watch your Vercel deployments happen in real time on every new tab.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.vercel.com/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
